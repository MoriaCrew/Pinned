# Pinned — environment variables (copy to .env.local; NEVER commit real values)
# App modes (safe defaults: tests + judge demo run exactly like this)
AUTH_MODE=link-only
AI_MOCK=1
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=

# Firebase (project IDs are public; service-account keys are NOT — use
# `gcloud auth application-default login` locally, Secret Manager in prod)
FIREBASE_PROJECT_ID=moriacrew-pinned-dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=moriacrew-pinned-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Primary inference: Meta Model API (hackathon credits, Standard mode)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Model IDs — pinned by the PIN-3 smoke test, then recorded in docs/02 ADR
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_SAM=sam-3.1
META_MODEL_IMAGE=muse-image-1.0

# Partner fallback (optional until PIN-4 gateway wiring lands)
BASETEN_API_KEY=
FIREWORKS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Stripe test-mode only (PIN-25, gated) — test keys only, never live keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
