# Pinned — environment variables (copy to .env.local; NEVER commit real values)
# App modes (safe defaults: tests + demo run exactly like this)
# AUTH_MODE: link-only (default) or optional (adds Google sign-in
# + the My boards / My pins library; needs the Firebase web
# config below - see docs/13-auth.md)
AUTH_MODE=link-only
# AUTH_SAME_ORIGIN=1 (optional mode only, PIN-163): Google sign-in runs
# on APP_BASE_URL's host - /__/auth/* is proxied to the project's
# firebaseapp host and the web authDomain becomes the app host (https
# APP_BASE_URL + valid FIREBASE_PROJECT_ID required, else unchanged).
# Build-time: rebuild after changing it. Needs the OAuth redirect URI
# https://<app host>/__/auth/handler on the web client (docs/13-auth.md).
AUTH_SAME_ORIGIN=
AI_MOCK=1
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=
# Seeded judge demo board slug (PIN-73, npm run seed:demo). Capability
# secret: set ONLY in the host env / .env.local, never commit a value.
# Unset or invalid = landing demo link stays hidden.
DEMO_BOARD_SLUG=
# Board Plus billing (PIN-103/PIN-149, docs/15-board-plus.md): off (default)
# answers every checkout "unavailable" and writes nothing; mock grants
# Plus instantly for demos (labelled source "mock", no money moves).
# Never set mock on prod.
PLUS_MODE=off
# Stripe credit packs (PIN-149): PLUS_MODE=stripe also requires the
# secret key below (a restricted rk_ key is enough); stripe without
# a key fails closed to off. Hosted backends reference the key from
# Secret Manager by this name - never commit a value.
STRIPE_SECRET_KEY=
# Local default is memory. Hosted environments set this to firestore.
DATA_BACKEND=memory

# Firebase (project IDs are public; service-account keys are NOT — use
# `gcloud auth application-default login` locally, Secret Manager in prod)
FIREBASE_PROJECT_ID=moriacrew-pinned-dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=moriacrew-pinned-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Daily live-AI guardrails (mock fallback when reached)
AI_DAILY_BUDGET_USD=2
AI_DAILY_CALL_LIMIT=200
# Optional Policy overrides as JSON (PIN-59, docs/11 s5.1); 0 budget = off
POLICY_OVERRIDES_JSON=

# Primary inference: Meta Model API (hackathon credits, Standard mode)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Model IDs — pinned by the PIN-3 smoke test, then recorded in docs/02 ADR
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_SAM=sam-3.1
META_MODEL_IMAGE=muse-image-1.0
