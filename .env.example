# Pinned — environment variables (copy to .env; NEVER commit .env)
# Primary inference: Meta Model API (hackathon $150 credits, Standard mode)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Model IDs — confirm exact IDs in the Day-1 smoke test (PIN-3), then pin here
META_MODEL_SPARK=
META_MODEL_SAM=
META_MODEL_IMAGE=

# Partner fallback (Muse Spark Open / open weights) — optional until PIN-4 lands
BASETEN_API_KEY=
FIREWORKS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# App
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=
DATABASE_URL=
# S3-compatible object storage (cut-outs + posters ONLY; never originals)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# 1 = mock all AI calls (CI + previews). Production must be 0/unset.
AI_MOCK=1
