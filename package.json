{
  "name": "pinned",
  "version": "0.1.0",
  "description": "Pinneds Studio - your stuff, pinned together: Muse Spark names photo elements, SAM 3.1 cuts them out, friends pin them, Muse Image composes credited scenes.",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run i18n:check",
    "tokens": "node scripts/build-tokens.mjs",
    "og:card": "WRITE_OG_CARD=1 vitest run src/server/og-card.test.ts",
    "test": "vitest run",
    "smoke:meta": "node scripts/meta-smoke.mjs",
    "spike:studio": "node scripts/studio-spike.mjs",
    "seed:demo": "node scripts/seed-demo-board.mjs",
    "seed:stripe-catalog": "node scripts/seed-stripe-catalog.mjs",
    "usage:report": "node scripts/usage-report.mjs",
    "usage:costs": "node scripts/usage-costs.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "billing:reconcile": "node scripts/billing-reconciliation.mjs",
    "billing:webhook-endpoint": "node scripts/ensure-stripe-webhook-endpoint.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/storage": "^8.4.0",
    "@meta-sam/parser": "^0.1.0",
    "@tanstack/react-query": "^5.105.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^13.10.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
